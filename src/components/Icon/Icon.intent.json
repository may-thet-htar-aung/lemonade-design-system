  "a11y": [
    {
      "text": "Renders a <span> holding the SVG markup.",
      "source": "code:src/components/Icon/Icon.tsx:71 · code:src/components/Icon/Icon.tsx:76"
    },
    {
      "text": "Without a Label it is aria-hidden=\"true\" and has no role.",
      "source": "code:src/components/Icon/Icon.tsx:73 · code:src/components/Icon/Icon.tsx:75"
    },
    {
      "text": "With a Label it gets role=\"img\" and aria-label set to the Label.",
      "source": "code:src/components/Icon/Icon.tsx:73 · code:src/components/Icon/Icon.tsx:74"
    },
    {
      "text": "It is never focusable: no tabindex and no interactive element.",
      "source": "code:src/components/Icon/Icon.tsx:71"
    },
    {
      "text": "When a text label sits next to the icon, leave Label empty and hide the icon from screen readers with aria-hidden=\"true\".",
      "source": "figma:79:639"
    },
    {
      "text": "An icon on its own needs an accessible name. Set the Label property; code uses it as aria-label, such as \"Search\".",
      "source": "figma:79:642"
    },
    {
      "text": "Icons never take focus. Focus goes to the button or link that holds them.",
      "source": "figma:79:645"
    },
    {
      "text": "The 24 × 24 icon is not a touch target. Place it in a control of at least 44 × 44, such as Icon Button.",
      "source": "figma:79:648"
    },
    {
      "text": "Keep the icon at 3:1 or more against its background (WCAG 1.4.11). #2A313A passes on light surfaces, so override it on dark ones.",
      "source": "figma:79:651"
    }
  ],
