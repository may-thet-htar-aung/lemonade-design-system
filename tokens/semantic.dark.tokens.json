  "color-text-static-dark": {
    "$type": "color",
    "$value": "{color-neutral-900}",
    "$description": "Dark text that stays dark in Light and Dark mode. Use only on backgrounds that do not change between modes, such as brand yellow, status fills or photos."
  },
  "color-text-static-light": {
    "$type": "color",
    "$value": "{color-neutral-0}",
    "$description": "Light text that stays light in Light and Dark mode. Use only on backgrounds that do not change between modes, such as brand green or photos."
  },
  "color-icon-static-dark": {
    "$type": "color",
    "$value": "{color-neutral-900}",
    "$description": "Dark icon colour that stays dark in both modes. Pair with color/text/static/dark."
  },
  "color-icon-static-light": {
    "$type": "color",
    "$value": "{color-neutral-0}",
    "$description": "Light icon colour that stays light in both modes. Pair with color/text/static/light."
  },
  "color-icon-brandbold": {
    "$type": "color",
    "$value": "{color-neutral-0}",
    "$description": "Brand green icon in Light mode, white in Dark mode. Use for icons that sit next to color/text/primary titles on tinted backgrounds, such as Callout."
  },
  "color-bg-static-brandgreen": {
    "$type": "color",
    "$value": "{color-forest-green-600}",
    "$description": "Brand green background that stays the same in Light and Dark mode. Pair with color/icon/static/light or color/text/static/light, such as the Done dot in Timeline Step."
  },
  "color-text-brandbold": {
    "$type": "color",
    "$value": "{color-neutral-0}",
    "$description": "Brand green text in Light mode, white in Dark mode. Text partner of color/icon/brandBold. Used for Outline and Ghost button labels."
  }
