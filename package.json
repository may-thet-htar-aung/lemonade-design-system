{
  "name": "@may_thet_htar_aung/lemonade-design-system",
  "version": "0.2.0",
  "description": "",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build:tokens": "node build-tokens.js",
    "build:lib": "tsup && tsc -p tsconfig.build.json",
    "build:css": "node scripts/build-css.mjs",
    "build:package": "npm run build:tokens && npm run build:lib && npm run build:css",
    "prepublishOnly": "npm run build:package && npm test",
    "release:publish": "node scripts/release-publish.mjs",
    "test": "npm run typecheck && node scripts/verify-tokens.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "style-dictionary": "^5.6.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
