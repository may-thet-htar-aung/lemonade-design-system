    },
    {
      "text": "Use the same icon for the same action everywhere, such as x to close.",
      "source": "figma:81:381"
    },
    {
      "text": "Pick the size with the Size property. lg (24) is the default.",
      "source": "figma:81:385"
    },
    {
      "text": "Set the colour on the instance to match the text or surface around it.",
      "source": "figma:81:389"
    },
    {
      "text": "Add a text label when the meaning is not obvious from the icon.",
      "source": "figma:81:393"
    }
  ],
  "dont_use_when": [
    {
      "text": "Do not detach an icon to change it. Switch the Name instead.",
      "source": "figma:79:604"
    },
    {
      "text": "Do not edit or redraw the vector inside an instance.",
      "source": "figma:81:397"
    },
    {
      "text": "Do not resize an instance by hand. Switch Size instead.",
      "source": "figma:81:401"
    },
    {
      "text": "Do not mix in icons from other icon sets.",
      "source": "figma:81:405"
    },
    {
      "text": "Do not use an icon alone for an action people may not recognise.",
      "source": "figma:81:409"
    }
  ],
  "best_practice": [
    {
      "text": "Give an icon and its label the same colour in a row.",
